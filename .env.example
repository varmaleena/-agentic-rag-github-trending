# System & AWS Configuration
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

# Qdrant Vector Database Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333

# GitHub API Credentials (for higher rate limits)
GITHUB_TOKEN=

# RAG & Agent Evaluation Settings
EVAL_SCORE_THRESHOLD=0.7
MAX_RETRIEVAL_RETRIES=3

# Optional Vertex AI provider (uses Application Default Credentials)
LLM_PROVIDER=bedrock
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=

# Production credentials come from a secrets manager.
QDRANT_URL=
QDRANT_API_KEY=
HISTORY_DATABASE_URL=
HISTORY_DB_PATH=data/query_history.sqlite3
